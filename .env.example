# ─────────────────────────────────────────────────────────────
# Claude API
# https://console.anthropic.com 에서 발급
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 워드프레스 사이트별 인증 (Application Passwords)
# 워드프레스 관리자 > 사용자 > 프로필 > 애플리케이션 비밀번호 발급
# 형식: 사이트키별로 URL / 사용자명 / 앱비밀번호 3개를 채운다.
# 사이트키는 src/config.py 의 SITES 와 일치해야 한다.
# ─────────────────────────────────────────────────────────────

# finwiz.tistory.com 는 티스토리라 REST API 발행 불가 → 워드프레스 사이트만 등록
# 예) bodybalance-labo.com (건강, 애드센스 승인됨)
WP_BODYBALANCE_URL=https://bodybalance-labo.com
WP_BODYBALANCE_USER=admin
WP_BODYBALANCE_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 예) seaga.co.kr (잡블로그, 애드센스 승인됨)
WP_SEAGA_URL=https://seaga.co.kr
WP_SEAGA_USER=admin
WP_SEAGA_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 예) calculator.seaga.co.kr (계산기/유틸)
WP_CALCULATOR_URL=https://calculator.seaga.co.kr
WP_CALCULATOR_USER=admin
WP_CALCULATOR_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
