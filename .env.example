# ─────────────────────────────────────────────────────────────
# Claude API
# https://console.anthropic.com 에서 발급
# ─────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─────────────────────────────────────────────────────────────
# 워드프레스 사이트별 인증 (Application Passwords)
# 워드프레스 관리자 > 사용자 > 프로필 > 애플리케이션 비밀번호 발급
# 형식: 사이트키별로 URL / 사용자명 / 앱비밀번호 3개를 채운다.
# 사이트키는 src/config.py 의 SITES 와 일치해야 한다.
# ─────────────────────────────────────────────────────────────

# finwiz.tistory.com 는 티스토리라 REST API 발행 불가 → 워드프레스 사이트만 등록
# 예) bodybalance-labo.com (건강, 애드센스 승인됨)
WP_BODYBALANCE_URL=https://bodybalance-labo.com
WP_BODYBALANCE_USER=admin
WP_BODYBALANCE_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 예) seaga.co.kr (잡블로그, 애드센스 승인됨)
WP_SEAGA_URL=https://seaga.co.kr
WP_SEAGA_USER=admin
WP_SEAGA_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# 예) calculator.seaga.co.kr (계산기/유틸)
WP_CALCULATOR_URL=https://calculator.seaga.co.kr
WP_CALCULATOR_USER=admin
WP_CALCULATOR_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─────────────────────────────────────────────────────────────
# 글 이관(migrate)용 — SITES 에 없는 사이트도 접두사만 맞추면 즉석 사용 가능.
# 예) --from-site a --to-site b  →  WP_A_*, WP_B_* 를 읽는다.
# ─────────────────────────────────────────────────────────────
# WP_A_URL=https://old-site.com
# WP_A_USER=admin
# WP_A_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx
# WP_B_URL=https://new-site.com
# WP_B_USER=admin
# WP_B_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ─────────────────────────────────────────────────────────────
# 애드센스 — "받는 쪽(B)" 도메인으로 승인받은 코드를 사이트 접두사별로 등록.
# CLIENT: 게시자 ID (애드센스 > 계정 > 설정 > 계정 정보)
# SLOTS : 광고 단위 슬롯 ID를 쉼표로 나열 (본문 상단/중단/하단 순서로 삽입됨.
#         1개만 넣으면 모든 위치에 같은 단위를 재사용한다.)
# ─────────────────────────────────────────────────────────────
# ADSENSE_B_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# ADSENSE_B_SLOTS=1111111111,2222222222,3333333333
# ADSENSE_BODYBALANCE_CLIENT=ca-pub-XXXXXXXXXXXXXXXX
# ADSENSE_BODYBALANCE_SLOTS=1111111111,2222222222,3333333333

# ─────────────────────────────────────────────────────────────
# 썸네일 이미지 — 한글 폰트 경로(.ttf/.ttc). 비우면 흔한 경로에서 자동 탐색
# (나눔고딕, Noto Sans CJK, 맑은 고딕, Apple SD Gothic 순).
# ─────────────────────────────────────────────────────────────
# THUMBNAIL_FONT=/usr/share/fonts/truetype/nanum/NanumGothicBold.ttf
