function 다듬기(글자) {
  return String(글자 || '').trim().toLowerCase().replace(/[\s_\-·\/()]+/g, '');
}

function 탭가져오기() {
  var 문서 = 문서가져오기();
  var 탭 = 문서.getSheetByName(탭이름);
  if (!탭) {
    var 있는탭 = 문서.getSheets().map(function (s) {
      return s.getName();
    }).join(', ');
    throw new Error(
      "'" + 탭이름 + "' 탭을 찾지 못했습니다.\n" +
      '이 시트에 있는 탭: ' + 있는탭 + '\n' +
      "코드 맨 위의 탭이름 을 바꿔 주세요."
    );
  }
  return 탭;
}

/** 헤더에서 각 항목이 몇 번째 열인지 찾는다. 없으면 -1. */
function 열찾기(헤더) {
  var 다듬은헤더 = 헤더.map(다듬기);
  var 결과 = {};
  열규칙.forEach(function (규칙) {
    결과[규칙.키] = -1;
    var 후보 = [규칙.기본].concat(규칙.별칭);
    for (var i = 0; i < 후보.length; i++) {
      var 위치 = 다듬은헤더.indexOf(다듬기(후보[i]));
      if (위치 !== -1) { 결과[규칙.키] = 위치; break; }
    }
  });
  return 결과;
}

/** 저장할 열이 없으면 맨 뒤에 만든다. 만든 열 이름 목록을 돌려준다. */
function 없는열만들기(탭, 헤더, 열) {
  var 만들것 = 열규칙.filter(function (규칙) {
    return 규칙.만들기 && 열[규칙.키] === -1;
  });
  if (만들것.length === 0) return [];

  var 이름들 = 만들것.map(function (규칙) { return 규칙.기본; });
  탭.getRange(1, 헤더.length + 1, 1, 이름들.length).setValues([이름들]);
  return 이름들;
}

/** 탭을 열고 헤더·열위치를 준비한다. */
function 시트준비() {
  var 탭 = 탭가져오기();
  var 마지막열 = 탭.getLastColumn();
  if (마지막열 === 0) throw new Error("'" + 탭이름 + "' 탭이 비어 있습니다.");

  var 헤더 = 탭.getRange(1, 1, 1, 마지막열).getValues()[0];
  var 열 = 열찾기(헤더);
  var 만든열 = 없는열만들기(탭, 헤더, 열);

  if (만든열.length > 0) {
    마지막열 = 탭.getLastColumn();
    헤더 = 탭.getRange(1, 1, 1, 마지막열).getValues()[0];
    열 = 열찾기(헤더);
  }

  var 없는필수 = 열규칙.filter(function (규칙) {
    return 규칙.필수 && 열[규칙.키] === -1;
  }).map(function (규칙) { return 규칙.이름; });

  if (없는필수.length > 0) {
    throw new Error(
      '시트에서 다음 열을 찾지 못했습니다: ' + 없는필수.join(', ') + '\n' +
      '지금 시트의 열: ' + 헤더.join(', ')
    );
  }

  return { 탭: 탭, 헤더: 헤더, 열: 열, 만든열: 만든열 };
}


// ══════════════════════════════════════════════════════════
//  ① 글감 목록 (화면에서 부른다)
// ══════════════════════════════════════════════════════════

function 글감목록() {
  var 준비 = 시트준비();
  var 탭 = 준비.탭, 열 = 준비.열;
  var 마지막행 = 탭.getLastRow();
  if (마지막행 < 2) return { 목록: [], 만든열: 준비.만든열 };

  var 값 = 탭.getRange(2, 1, 마지막행 - 1, 탭.getLastColumn()).getValues();
  var 목록 = [];
  값.forEach(function (행, i) {
    var 키워드 = String(행[열.keyword] || '').trim();
    if (!키워드) return;
    목록.push({
      행번호: i + 2,
      키워드: 키워드,
      카테고리: String(행[열.category] || '').trim(),
      상태: String(행[열.status] || '').trim()
    });
  });
  return { 목록: 목록, 만든열: 준비.만든열, GPT주소: 마이GPT주소 };
}


// ══════════════════════════════════════════════════════════
//  ② My GPT 요청문 만들기
// ══════════════════════════════════════════════════════════

var 공통규칙 = [
  '- 키워드 뜻풀이가 아니라, 검색한 사람이 지금 궁금해하는 사실을 설명해 주세요.',
  '- 뉴스 제목을 블로그 제목으로 그대로 쓰지 마세요. 핵심 주제와 검색 의도에 맞게 새로 지어 주세요.',
  '- 출처 링크를 지어내지 마세요. 실제로 열리는 원문 링크만 쓰고, 확인이 안 되면 해당 기관이나 언론사 메인 주소를 쓰세요.',
  '- 메타 설명과 본문 첫 문단에 같은 문장을 반복하지 마세요.',
  '- 확인되지 않은 일정·조건·금액은 단정하지 마세요.',
  '- 롱테일은 최소 3개이고 같은 문구를 반복하지 마세요.',
  '- `왜 화제`, `핵심 정리`, `현재 상황` 같은 범용 템플릿 표현은 쓰지 마세요.',
  '- 디시, 더쿠, 인스티즈, 펨코 같은 커뮤니티 노이즈 키워드는 넣지 마세요.',
  '- 포커스 키워드를 제목, 메타 설명, H2 중 최소 한 곳에 자연스럽게 넣어 주세요.',
  '- 광고 자리 위아래에는 각각 한 줄만 두세요.',
  '- 본문은 한 문단이 한 줄이 되게 쓰고, 문단을 4개 이상 나눠 주세요.',
  '- 마지막 소제목은 반드시 `## 최종 정리하면` 으로 끝내 주세요. 글자를 바꾸지 마세요.'
];

/**
 * 요청문에 넣을 출력 형식.
 *
 * 한 번에 글 한 편만 요청한다. 워드프레스 글과 티스토리 글을 한 응답에
 * 같이 달라고 하면, 봇이 제목·메타·태그만 채우고 정작 본문 두 개를
 * 비워 버리는 일이 생긴다(실제로 그랬다).
 *
 * 형식도 봇이 평소 쓰는 마크다운 그대로 받는다. 대괄호 형식을 강요하면
 * 등록된 지침과 부딪혀 결과가 흔들린다. 저장할 때 이 마크다운을
 * 알아서 HTML 로 바꾼다.
 */
var 출력형식 = [
  '# (블로그 제목)',
  '',
  '(본문. 소제목은 ## 로, 목록은 - 로 씁니다. 표가 필요하면 넣어 주세요.)',
  '',
  '## 최종 정리하면',
  '(핵심을 2~3문단으로 짧게 정리. 이 소제목 글자는 그대로 두세요.)',
  '',
  '## 메타 디스크립션',
  '(검색결과에 뜰 설명 한 문장. 120~155자)',
  '',
  '## 관련 태그',
  '(태그를 쉼표로 구분해 8~10개)',
  '',
  '## 출처',
  '- (출처 제목) | https://(실제로 열리는 원문 링크)'
].join('\n');

function 카테고리찾기(이름) {
  var 값 = String(이름 || '').trim();
  if (!값) {
    throw new Error(
      '이 행의 카테고리 칸이 비어 있습니다.\n' +
      '시트에서 카테고리를 채운 뒤 다시 해 주세요.\n' +
      '쓸 수 있는 값: ' + Object.keys(카테고리표).join(', ')
    );
  }
  var 정보 = 카테고리표[값];
  if (!정보) {
    throw new Error(
      "모르는 카테고리입니다: '" + 값 + "'\n" +
      '쓸 수 있는 카테고리: ' + Object.keys(카테고리표).join(', ')
    );
  }
  return 정보;
}

/**
 * 화면이 알려준 행이 아직 그 글감인지 확인한다.
 *
 * 목록을 띄운 뒤에 시트에서 행이 지워지거나 옮겨지면 번호가 밀린다.
 * 그대로 두면 엉뚱한 행을 읽거나 — 더 나쁘게 — 엉뚱한 행에 글을 쓴다.
 * 그래서 키워드로 한 번 맞춰 보고, 어긋나면 키워드로 다시 찾는다.
 */
function 행찾기(탭, 열, 행번호, 키워드) {
  키워드 = String(키워드 || '').trim();
  var 마지막행 = 탭.getLastRow();
  행번호 = Number(행번호) || 0;

  if (행번호 >= 2 && 행번호 <= 마지막행) {
    var 지금 = String(탭.getRange(행번호, 열.keyword + 1).getValue() || '').trim();
    if (!키워드 || 지금 === 키워드) return 행번호;
  }
  if (!키워드) {
    throw new Error(
      행번호 + '행은 비어 있거나 시트 범위를 벗어났습니다.\n' +
      '왼쪽 위 "← 목록으로" 를 눌러 목록을 새로 불러와 주세요.'
    );
  }

  if (마지막행 >= 2) {
    var 값 = 탭.getRange(2, 열.keyword + 1, 마지막행 - 1, 1).getValues();
    for (var i = 0; i < 값.length; i++) {
      if (String(값[i][0] || '').trim() === 키워드) return i + 2;
    }
  }
  throw new Error(
    "시트에서 이 글감을 찾지 못했습니다: '" + 키워드 + "'\n" +
    '그 사이에 행이 지워졌거나 옮겨진 것 같습니다.\n' +
    '왼쪽 위 "← 목록으로" 를 눌러 목록을 새로 불러와 주세요.'
  );
}

/**
 * 글 한 편 분량의 요청문을 만든다.
 *
 * 채널: 'wordpress' | 'tistory'. 둘 다 쓰는 카테고리는 한 번씩 두 번 만든다.
 */
function 요청문만들기(행번호, 채널, 키워드) {
  var 준비 = 시트준비();
  var 탭 = 준비.탭, 열 = 준비.열;
  행번호 = 행찾기(탭, 열, 행번호, 키워드);
  var 행 = 탭.getRange(행번호, 1, 1, 탭.getLastColumn()).getValues()[0];

  var 카테고리이름 = String(행[열.category] || '').trim();
  var 정보 = 카테고리찾기(카테고리이름);
  var 둘다 = !!정보.워드프레스 && !!정보.티스토리;

  // 채널이 안 정해졌으면 이 카테고리가 쓰는 쪽으로 정한다
  if (채널 !== 'wordpress' && 채널 !== 'tistory') {
    채널 = 정보.워드프레스 ? 'wordpress' : 'tistory';
  }
  var 티스토리글 = (채널 === 'tistory');
  var 올릴곳 = 티스토리글
    ? '티스토리(' + 정보.티스토리 + ')'
    : '워드프레스(' + 정보.워드프레스 + ')';

  var 규칙 = 공통규칙.slice();
  if (티스토리글) {
    규칙.push('- 40대 이상 독자를 생각해 친절하고 쉬운 존댓말로 써 주세요.');
  }
  if (둘다) {
    규칙.push(
      '- 이 키워드로 ' + (티스토리글 ? '워드프레스' : '티스토리') +
      '용 글도 따로 씁니다. 그쪽과 제목·메타 설명·본문 구조·문장이 겹치지 않게, ' +
      (티스토리글 ? '이 글은 생활 밀착형으로' : '이 글은 정보 정리형으로') + ' 써 주세요.'
    );
  }
  if (['최신이슈', '신장정신', '정책지원'].indexOf(카테고리이름) !== -1) {
    규칙.push('- 뉴스 글은 본문 초반에 `출처: 뉴스 제목 바로가기` 를 표시하고, 배경·핵심 사실·의미·확인할 점을 자연스럽게 풀어 주세요.');
  }
  규칙.push('- 카테고리 원칙: ' + 정보.원칙);

  var 정보줄 = ['[글쓰기 정보]',
                '메인 키워드: ' + String(행[열.keyword] || '').trim(),
                '카테고리: ' + 카테고리이름];

  var 롱테일칸 = 티스토리글 ? 'ts롱테일' : 'wp롱테일';
  var 롱테일 = (열[롱테일칸] !== -1 && 열[롱테일칸] !== undefined)
    ? String(행[열[롱테일칸]] || '').trim() : '';
  if (롱테일) {
    정보줄.push('참고 롱테일: ' + 롱테일);
  } else if (티스토리글 && 열['wp롱테일'] !== -1) {
    // 시트에 티스토리 롱테일 열이 없을 때. 워드프레스 롱테일을 그대로 쓰면
    // 두 채널이 같아지므로, 참고만 하고 새로 만들라고 분명히 알린다.
    var 참고 = String(행[열['wp롱테일']] || '').trim();
    정보줄.push('참고 롱테일: ' + (참고 ?참고 + ' (워드프레스용입니다. 티스토리용으로 새로 3개 이상 만들어 주세요)' : '(없음)'));
  } else {
    정보줄.push('참고 롱테일: (없음)');
  }

  정보줄.push('참고 출처: ' +
    (열.source !== -1 ? (String(행[열.source] || '').trim() || '(없음)') : '(없음)'));
  정보줄.push('이번 글을 올릴 곳: ' + 올릴곳);

  return [
    정보줄.join('\n'),
    '',
    '[요청]',
    '위 키워드와 출처를 먼저 웹 검색으로 확인해 주세요.',
    '그다음 위에 적힌 곳에 올릴 블로그 글 **한 편**을 끝까지 완성해 주세요.',
    '개요나 목차만 주지 말고, 바로 발행할 수 있는 완성된 본문을 써 주세요.',
    '',
    '[지켜야 할 규칙]',
    규칙.join('\n'),
    '',
    '[출력 형식]',
    '아래 순서로만 답해 주세요. 인사말이나 설명은 붙이지 마세요.',
    '',
    출력형식
  ].join('\n');
}


// ══════════════════════════════════════════════════════════
//  ③ My GPT 응답 나누기와 검사
// ══════════════════════════════════════════════════════════

var 항목이름 = {
  WORDPRESS_TITLE: '워드프레스 제목',
  WORDPRESS_META_DESCRIPTION: '워드프레스 메타 설명',
  WORDPRESS_TAGS: '워드프레스 태그',
  WORDPRESS_HTML: '워드프레스 본문',
  TISTORY_TITLE: '티스토리 제목',
  TISTORY_META_DESCRIPTION: '티스토리 메타 설명',
  TISTORY_TAGS: '티스토리 태그',
  TISTORY_HTML: '티스토리 본문',
  FOCUS_KEYWORD: '포커스 키워드',
  SOURCES: '출처'
};

/** 대괄호 제목을 기준으로 응답을 나눈다. */
function 항목나누기(글) {
  글 = String(글 || '').trim();
  if (!글) return {};

  // 전체를 코드블록으로 감싸 복사한 경우 벗겨낸다
  if (글.indexOf('```') === 0) {
    글 = 글.replace(/^```[a-zA-Z]*\n/, '').replace(/\n```\s*$/, '').trim();
  }

  var 정규식 = /^[ \t]*\[([A-Z_]+)\][ \t]*$/gm;
  var 위치들 = [], m;
  while ((m = 정규식.exec(글)) !== null) {
    위치들.push({ 이름: m[1], 시작: m.index, 끝: 정규식.lastIndex });
  }

  var 결과 = {};
  위치들.forEach(function (항목, i) {
    var 끝 = (i + 1 < 위치들.length) ? 위치들[i + 1].시작 : 글.length;
    결과[항목.이름] = 글.substring(항목.끝, 끝).trim();
  });
  return 결과;
}

// ══════════════════════════════════════════════════════════
//  마이 GPT 마크다운 형식 읽기
//
//  마이 GPT 는 등록된 지침이 대화창 요청보다 세서, 요청문에 대괄호
//  형식을 넣어도 자기 형식(마크다운)으로 답한다. 그래서 그 형식을
//  그대로 읽는다. 지침을 건드리지 않아도 되게 하기 위함이다.
//
//  구조:
//    # 제목
//    (본문 ... ## 소제목 ... )
//    ## 검색 키워드 구성   ← 여기부터는 본문이 아니라 부가정보
//    **메인 키워드:** ...
//    ## 메타 디스크립션
//    ## 관련 태그 10개
// ══════════════════════════════════════════════════════════

/** 본문이 아니라 부가정보인 꼬리 섹션들 */
var 꼬리섹션 = [
  '검색 키워드 구성', '메타 디스크립션', '메타디스크립션', '이미지 alt 태그 추천',
  '이미지 alt', '외부 참고자료', '관련해서 볼 글', '광고 배치 추천',
  '관련 태그', '관련태그', '출처', '참고 자료',
  '기타 seo', 'seo 요소', 'seo 체크', '내부/외부 링크', '해시태그'
];

/**
 * 소제목에서 장식을 걷어낸다.
 *
 * 봇마다 '## **[광고 위치]**', '## 6. 마무리글 (정리 및 결론)' 처럼
 * 굵게 표시나 번호를 붙인다. 비교할 때는 알맹이만 본다.
 */
function 소제목정리(글자) {
  return String(글자 || '')
    .replace(/^#+\s*/, '')
    .replace(/\*+/g, '')
    .replace(/^\s*\d+[.)]\s*/, '')
    .trim();
}

function 꼬리섹션인가(제목) {
  var t = 소제목정리(제목).toLowerCase();
  for (var i = 0; i < 꼬리섹션.length; i++) {
    if (t.indexOf(꼬리섹션[i]) === 0) return true;
  }
  return false;
}

/**
 * 글이 아니라 '작업 메모'인 섹션인가.
 *
 * 봇은 글을 쓰기 전에 자기 계획을 늘어놓는다. 이런 것들이다.
 *   롱테일 의도 해석: '수면 뉴스 해설'과 ...
 *   제목(권장): 등 센서 생기기 전에 ...
 *   목차(구성 안내)
 *   SEO 키워드 분석 및 선정
 * 독자에게 보일 글이 아니므로 본문에서 통째로 뺀다.
 */
function 계획섹션인가(제목) {
  var t = 소제목정리(제목).toLowerCase().replace(/\s+/g, '');
  if (/키워드/.test(t) && /(분석|선정|구성|추출)/.test(t)) return true;
  if (/(제목|title)/.test(t) && /(추천|후보|권장|안내|title|리스트)/.test(t)) return true;
  if (/의도/.test(t) && /(해석|분석|파악)/.test(t)) return true;
  if (/^(목차|구성안내|개요|아웃라인|outline)/.test(t)) return true;
  if (/(글|콘텐츠|본문)구조/.test(t)) return true;
  if (/^seo/.test(t) && /(분석|전략|구성|설계)/.test(t)) return true;
  return false;
}

/** 예전 이름. 본문 앞쪽 건너뛰기에서 쓴다. */
function 머리섹션인가(제목) {
  return 계획섹션인가(제목);
}

/**
 * 본문 어디에 있든 계획 섹션을 통째로 뺀다.
 *
 * 앞쪽만 건너뛰면, 도입부 뒤에 '목차' 를 넣는 봇의 글에서 그게 남는다.
 * 소제목을 만나면 그 단계보다 깊은 줄까지 함께 버린다.
 */
function 계획섹션빼기(본문) {
  var 줄들 = String(본문 || '').split('\n');
  var 나온것 = [], 버리는중 = false, 버린단계 = 0;

  for (var i = 0; i < 줄들.length; i++) {
    var m = /^(#{1,6})\s+(.+)$/.exec(줄들[i].trim());
    if (m) {
      var 단계 = m[1].length;
      if (계획섹션인가(m[2])) { 버리는중 = true; 버린단계 = 단계; continue; }
      if (버리는중 && 단계 <= 버린단계) 버리는중 = false;
    }
    if (!버리는중) 나온것.push(줄들[i]);
  }
  return 나온것.join('\n').trim();
}

/**
 * 줄에서 광고 자리표를 지운다.
 *
 * 봇마다 모양이 제각각이다.
 *   [광고 추천 위치 1]
 *   ## **[이곳에 애드센스 디스플레이 광고 삽입 위치 1]**
 *   > [광고 위치 추천 1: 서론이 끝나고 본론으로 넘어가기 직전]
 * 앞에 인용부호나 굵게 표시가 붙으면 '이 줄 통째로 광고 표시인가' 만
 * 봐서는 못 잡는다. 그래서 대괄호 덩어리를 잘라내고, 남은 게
 * 부호뿐이면 빈 줄로 만든다.
 *
 * 광고는 발행 도구가 문단 수를 세어 알아서 넣는다. 이 표시는 글에
 * 남으면 안 된다.
 */
function 광고자리지우기(줄) {
  var t = String(줄 || '')
    .replace(/\[[^\]]*(?:광고|애드센스|adsense|ad\s*slot)[^\]]*\]/gi, '')
    .replace(/\([^)]*(?:광고\s*(?:위치|자리|삽입)|애드센스)[^)]*\)/gi, '');
  // 대괄호를 지우고 나면 '> ', '## **', '- ' 같은 껍데기만 남는다
  if (/^[\s>*#\-–—:·]*$/.test(t)) return '';
  return t.trim();
}

/** 광고 자리만 표시해 둔 줄인가. */
function 광고자리인가(글자) {
  var 알맹이 = 소제목정리(글자);
  if (/^\[[^\]]*(?:광고|애드센스|adsense)[^\]]*\]$/i.test(알맹이)) return true;
  // '> [광고 위치 추천 1: ...]' 처럼 앞에 뭐가 붙은 경우
  return 알맹이 !== '' && 광고자리지우기(글자) === '';
}

/**
 * '- **관련태그:** 가, 나, 다' 같은 줄에서 값만 꺼낸다.
 *
 * 섹션 제목(## 관련 태그) 없이 목록 한 줄로 적어 주는 봇이 많다.
 */
function 라벨값(글, 이름패턴) {
  var 정규식 = new RegExp(
    '^[\\s>]*[-*•]?\\s*\\**\\s*(?:' + 이름패턴 + ')[^:：\\n]*[:：]\\**\\s*(.+)$', 'im');
  var m = 정규식.exec(String(글 || ''));
  if (!m) return '';
  return m[1].replace(/\*+/g, '').trim();
}

/**
 * '## 이름' 섹션의 내용을 꺼낸다.
 *
 * 자바스크립트 정규식에는 \Z(문자열 끝)가 없다. 그래서 제목 위치를 먼저
 * 찾고, 그 뒤에서 다음 '##' 을 따로 찾는 방식으로 잘라낸다. 이렇게 해야
 * 맨 마지막 섹션(보통 태그)도 제대로 읽힌다.
 */
function 섹션내용(글, 이름) {
  var 제목 = new RegExp('^##\\s*' + 이름 + '[^\\n]*$', 'm').exec(글);
  if (!제목) return '';
  var 뒤 = 글.substring(제목.index + 제목[0].length);
  var 다음 = /^##\s/m.exec(뒤);
  var 내용 = 다음 ? 뒤.substring(0, 다음.index) : 뒤;
  return 내용.replace(/^-+$/gm, '').trim();
}

/**
 * 봇이 준 마크다운을 제목·본문·메타·태그·포커스로 나눈다.
 *
 * 봇마다 형식이 다르다. 그래서 정해진 틀을 요구하지 않고, 있는 그대로
 * 읽어서 시트 형식에 맞춰 준다.
 *  - 제목이 '# 제목' 이 아니라 '제목 추천 5가지' 목록으로 오면 첫 번째를 쓴다
 *  - 앞에 붙은 'SEO 키워드 분석' 같은 준비 섹션은 본문에서 뺀다
 *  - 메타·태그가 '- **관련태그:** ...' 한 줄로 와도 찾아낸다
 * 무엇을 알아서 정했는지는 메모에 담아 화면에 알려 준다.
 */
function 마크다운나누기(글) {
  글 = String(글 || '').trim();
  if (글.indexOf('```') === 0) {
    글 = 글.replace(/^```[a-zA-Z]*\n/, '').replace(/\n```\s*$/, '').trim();
  }
  if (!글) return null;

  var 메모 = [];

  // 소제목 위치를 전부 모은다 (# ~ ####)
  var 소제목들 = [], m;
  var 정규식 = /^(#{1,4})\s+(.+)$/gm;
  while ((m = 정규식.exec(글)) !== null) {
    소제목들.push({ 단계: m[1].length, 이름: m[2].trim(),
                    시작: m.index, 끝: m.index + m[0].length });
  }

  // ── 제목 ───────────────────────────────────────────────
  var 제목 = '', 본문시작 = 0;
  var h1 = null;
  for (var i = 0; i < 소제목들.length; i++) {
    if (소제목들[i].단계 === 1) { h1 = 소제목들[i]; break; }
  }
  if (h1) {
    제목 = 소제목정리(h1.이름);
    본문시작 = h1.끝;
  } else {
    // '제목 추천 5가지' 목록에서 첫 번째를 가져온다
    for (var j = 0; j < 소제목들.length; j++) {
      if (!머리섹션인가(소제목들[j].이름)) continue;
      if (!/제목|title/i.test(소제목정리(소제목들[j].이름))) continue;
      var 끝 = (j + 1 < 소제목들.length) ? 소제목들[j + 1].시작 : 글.length;
      var 첫줄 = /^\s*(?:\d+[.)]|[-*•])\s+(.+)$/m.exec(글.substring(소제목들[j].끝, 끝));
      if (첫줄) {
        제목 = 소제목정리(첫줄[1]);
        메모.push('제목은 추천 목록의 첫 번째를 썼습니다: ' + 제목);
        break;
      }
    }
    // '## 제목(권장): 등 센서 생기기 전에 ...' 처럼 소제목 줄에 제목이 붙은 경우
    if (!제목) {
      for (var q = 0; q < 소제목들.length; q++) {
        var 알맹이 = 소제목정리(소제목들[q].이름);
        if (!계획섹션인가(알맹이)) continue;
        if (!/제목|title/i.test(알맹이)) continue;
        var 콜론 = /[:：]\s*(.+)$/.exec(알맹이);
        if (콜론 && 콜론[1].trim().length >= 6) {
          제목 = 콜론[1].trim();
          메모.push('제목은 "제목(권장)" 줄에서 가져왔습니다.');
          break;
        }
      }
    }
    if (!제목) {
      제목 = 라벨값(글, '제목|title');
      if (제목) 메모.push('제목은 "제목:" 줄에서 가져왔습니다.');
    }
  }
  if (!제목) return null;

  // '— 수면 뉴스 해설과 확인된 내용' 같은 꼬리는 키워드 수집이 붙인 것이다
  var 꼬리없앤제목 = 제목.replace(
    /\s*[—–-]\s*[^—–-]*(?:뉴스\s*해설|확인된\s*내용|관련\s*소식)[^—–-]*$/, '').trim();
  if (꼬리없앤제목.length >= 8 && 꼬리없앤제목 !== 제목) {
    메모.push('제목 뒤의 "' + 제목.substring(꼬리없앤제목.length).trim() + '" 은 뺐습니다.');
    제목 = 꼬리없앤제목;
  }

  // ── 본문 시작 ─────────────────────────────────────────
  // 앞에 붙은 준비 섹션(키워드 분석·제목 추천)은 본문이 아니다
  var k = 0;
  while (k < 소제목들.length && 소제목들[k].시작 < 본문시작) k++;
  while (k < 소제목들.length && 머리섹션인가(소제목들[k].이름)) {
    본문시작 = (k + 1 < 소제목들.length) ? 소제목들[k + 1].시작 : 글.length;
    if (메모.indexOf('앞쪽 키워드·제목 정리 부분은 본문에서 뺐습니다.') === -1) {
      메모.push('앞쪽 키워드·제목 정리 부분은 본문에서 뺐습니다.');
    }
    k++;
  }

  // ── 본문 끝 ───────────────────────────────────────────
  var 본문끝 = 글.length;
  for (var n = k; n < 소제목들.length; n++) {
    if (꼬리섹션인가(소제목들[n].이름)) { 본문끝 = 소제목들[n].시작; break; }
  }
  var 본문 = 계획섹션빼기(글.substring(본문시작, 본문끝));

  // ── 메타·태그·포커스 ──────────────────────────────────
  var 메타 = 섹션내용(글, '메타\\s*디스크립션') ||
             라벨값(글, '메타\\s*디스크립션|메타디스크립션|meta\\s*description');
  var 태그 = 섹션내용(글, '관련\\s*태그') ||
             라벨값(글, '관련\\s*태그|관련태그|해시\\s*태그|태그|tags?');
  if (!섹션내용(글, '메타\\s*디스크립션') && 메타) {
    메모.push('메타 설명은 목록 줄에서 찾았습니다.');
  }
  if (!섹션내용(글, '관련\\s*태그') && 태그) {
    메모.push('태그는 목록 줄에서 찾았습니다.');
  }

  var 포커스 = 라벨값(글, '메인\\s*키워드|포커스\\s*키워드|주\\s*키워드|focus\\s*keyword');
  var 포커스추정 = false;
  if (!포커스) { 포커스 = 제목.split(/[\s,·:]/)[0]; 포커스추정 = true; }

  return {
    제목: 제목,
    본문: 본문,
    메타: 메타.split('\n')[0].replace(/\*+/g, '').trim(),
    태그: 태그.split('\n')[0].replace(/\*+/g, '').replace(/\s*,\s*/g, ', ').trim(),
    포커스: 포커스,
    포커스추정: 포커스추정,
    출처: 섹션내용(글, '출처') || 섹션내용(글, '참고\\s*자료') ||
          섹션내용(글, '외부\\s*참고자료'),
    메모: 메모
  };
}

/** '| 항목 | 기준 |' 을 ['항목','기준'] 으로 나눈다. */
function 표칸나누기(줄) {
  var t = String(줄).trim().replace(/^\|/, '').replace(/\|$/, '');
  return t.split('|').map(function (칸) { return 칸.trim(); });
}

/**
 * '|---|---|' 또는 '| :--- | ---: |' 처럼 머리글과 본문을 가르는 줄인가.
 * 이 줄은 화면에 보이면 안 되는 줄이다. 예전에는 이걸 그대로 본문에
 * 넣어서 글에 |--- 가 찍혀 나갔다.
 */
function 표구분줄인가(줄) {
  var t = String(줄).trim();
  return t.indexOf('-') !== -1 && /^\|?[\s:|-]+\|[\s:|-]*$/.test(t);
}

/** 마이 GPT 마크다운을 발행용 HTML 로 바꾼다. */
/**
 * 표 모양.
 *
 * 티스토리 편집기는 <style> 덩어리를 지워 버린다. 각 칸에 style= 로
 * 직접 써 넣어야 테두리가 남는다. 워드프레스도 이 방식이면 그대로 나온다.
 * 넓은 표가 휴대폰에서 잘리지 않도록 가로 스크롤 상자로 감싼다.
 */
var 표겉모양   = 'width:100%;border-collapse:collapse;margin:18px 0;font-size:15px;line-height:1.6;';
var 표머리모양 = 'border:1px solid #d5d8dd;background:#f5f6f8;padding:10px 12px;text-align:left;font-weight:700;';
var 표칸모양   = 'border:1px solid #d5d8dd;padding:10px 12px;vertical-align:top;';
var 표상자모양 = 'overflow-x:auto;-webkit-overflow-scrolling:touch;';

/**
 * 옛날식 표 속성도 같이 넣는다.
 *
 * 티스토리 편집기가 style= 을 지워 버리는 경우가 있다. 그때도 선이 보이도록
 * border/cellpadding 같은 오래된 HTML 속성을 함께 쓴다. 이 속성들은
 * 편집기 정리(sanitize)를 대체로 통과한다. 둘 다 살아 있으면 style 이 이긴다.
 */
var 표옛속성 = ' border="1" cellpadding="8" cellspacing="0"';

function 마크다운을HTML로(마크다운) {
  var 줄들 = String(마크다운 || '').split('\n');
  var 나온것 = [], 목록열림 = false, 문단 = [], 표 = [];

  function 문단닫기() {
    if (문단.length) { 나온것.push('<p>' + 인라인(문단.join(' ')) + '</p>'); 문단 = []; }
  }
  function 목록닫기() {
    if (목록열림) { 나온것.push('</ul>'); 목록열림 = false; }
  }

  /** 모아 둔 표 줄들을 <table> 로 바꾼다. */
  function 표닫기() {
    if (!표.length) return;
    var 모은것 = 표; 표 = [];

    var 머리 = null;
    if (모은것.length >= 2 && 표구분줄인가(모은것[1])) {
      머리 = 표칸나누기(모은것[0]);
      모은것 = 모은것.slice(2);
    }
    // 남은 구분줄은 전부 버린다 (이게 |--- 로 새어 나가던 줄이다)
    모은것 = 모은것.filter(function (줄) { return !표구분줄인가(줄); });
    if (!머리 && !모은것.length) return;

    var 조각 = ['<div style="' + 표상자모양 + '">',
                '<table' + 표옛속성 + ' style="' + 표겉모양 + '">'];
    if (머리) {
      조각.push('<thead><tr>' + 머리.map(function (칸) {
        return '<th style="' + 표머리모양 + '">' + 인라인(칸) + '</th>';
      }).join('') + '</tr></thead>');
    }
    if (모은것.length) {
      조각.push('<tbody>');
      모은것.forEach(function (줄) {
        조각.push('<tr>' + 표칸나누기(줄).map(function (칸) {
          return '<td style="' + 표칸모양 + '">' + 인라인(칸) + '</td>';
        }).join('') + '</tr>');
      });
      조각.push('</tbody>');
    }
    조각.push('</table>');
    조각.push('</div>');
    나온것.push(조각.join('\n'));
  }

  function 인라인(t) {
    return t
      .replace(/\*\*(.+?)\*\*/g, '<strong>$1</strong>')
      .replace(/`([^`]+)`/g, '<code>$1</code>')
      .replace(/\[([^\]]+)\]\((https?:\/\/[^)]+)\)/g,
               '<a href="$2" target="_blank" rel="noopener">$1</a>');
  }

  for (var i = 0; i < 줄들.length; i++) {
    // 광고 자리표는 어디에 붙어 있든 먼저 잘라낸다
    var t = 광고자리지우기(줄들[i].trim());
    var 다음줄 = (i + 1 < 줄들.length) ? 줄들[i + 1].trim() : '';

    // ── 표 ──────────────────────────────────────────────
    // '|' 로 시작하는 줄, 또는 바로 아래가 '|---|' 인 줄부터 표로 본다.
    // (막대만 있고 앞 '|' 를 생략하는 봇이 있어서 다음 줄까지 본다)
    if (표.length
        ? (t.indexOf('|') !== -1)
        : (t.indexOf('|') === 0 || (t.indexOf('|') !== -1 && 표구분줄인가(다음줄)))) {
      문단닫기(); 목록닫기();
      표.push(t);
      continue;
    }
    표닫기();

    // 광고 자리 표시는 발행 도구가 알아서 넣으므로 본문에서 뺀다
    if (광고자리인가(t)) { 문단닫기(); 목록닫기(); continue; }
    if (t === '' ) { 문단닫기(); 목록닫기(); continue; }
    if (/^-{3,}$/.test(t)) { 문단닫기(); 목록닫기(); continue; }

    var h = /^(#{2,4})\s+(.+)$/.exec(t);
    if (h) {
      문단닫기(); 목록닫기();
      var 이름 = 소제목정리(h[2]);
      // '1. 머리글 (도입부)' 같은 뼈대 소제목은 글에 보이면 어색하다
      if (/^(머리글|도입부|들어가며|서론|인트로|시작하며)/.test(이름)) continue;
      // 닫는 소제목이 분명한 것만 바꾼다. '정리하며' 처럼 애매한 것은
      // 글 맨 끝에 있을 때만 마무리소제목맞추기 가 따로 바꿔 준다.
      if (/(마무리글|맺음말|결론|마치며)/.test(이름)) 이름 = '최종 정리하면';
      if (!이름) continue;
      var 단계 = Math.min(h[1].length, 4);
      나온것.push('<h' + 단계 + '>' + 인라인(이름) + '</h' + 단계 + '>');
      continue;
    }

    var li = /^[*\-]\s+(.+)$/.exec(t);
    if (li) {
      문단닫기();
      if (!목록열림) { 나온것.push('<ul>'); 목록열림 = true; }
      나온것.push('<li>' + 인라인(li[1].trim()) + '</li>');
      continue;
    }

    목록닫기();
    문단.push(t);
  }
  문단닫기(); 목록닫기(); 표닫기();
  return 마무리소제목맞추기(나온것.join('\n'));
}

/**
 * 마지막 정리 소제목을 '최종 정리하면' 으로 맞춘다.
 *
 * 발행 파이프라인은 이 소제목을 자리표로 쓴다.
 *  - 워드프레스: 광고의 before_summary 자리
 *  - 티스토리: 워드프레스 본문으로 보내는 안내 링크 자리
 * 이 소제목이 없으면 둘 다 그냥 건너뛴다. 봇이 '마무리하며' 처럼
 * 다르게 썼을 때만 글자를 맞춰 준다. 없는 소제목을 새로 만들지는 않는다.
 */
function 마무리소제목맞추기(HTML) {
  if (/<h2[^>]*>\s*최종\s*정리하면,?\s*<\/h2>/.test(HTML)) return HTML;

  var 찾기 = /<h2[^>]*>([^<]*)<\/h2>/g, m, 마지막 = null;
  while ((m = 찾기.exec(HTML)) !== null) 마지막 = m;
  if (!마지막) return HTML;
  if (!/정리|마무리|마치며|맺음|끝으로/.test(마지막[1])) return HTML;

  return HTML.substring(0, 마지막.index) + '<h2>최종 정리하면</h2>' +
         HTML.substring(마지막.index + 마지막[0].length);
}

/** '제목 | 링크' 목록을 정리한다. */
function 출처나누기(원본) {
  var 출처들 = [], 문제들 = [];
  String(원본 || '').split('\n').forEach(function (줄) {
    줄 = 줄.trim().replace(/^[-*]\s*/, '').trim();
    if (!줄) return;
    var 제목 = '', 링크 = 줄;
    var 막대 = 줄.lastIndexOf('|');
    if (막대 !== -1) {
      제목 = 줄.substring(0, 막대).trim();
      링크 = 줄.substring(막대 + 1).trim();
    }
    if (!/^https?:\/\/\S+$/.test(링크)) {
      문제들.push(
        "출처 링크가 주소 형식이 아닙니다: '" + 줄.substring(0, 60) + "' " +
        '(http:// 또는 https:// 로 시작하는 실제 링크여야 합니다)'
      );
      return;
    }
    출처들.push((제목 || 링크) + ' | ' + 링크);
  });
  return { 출처들: 출처들, 문제들: 문제들 };
}

function 내용없는HTML(값) {
  return String(값 || '').replace(/<[^>]+>/g, '').trim() === '';
}

/**
 * 메타 설명과 태그를 한 칸에 합친다.
 *
 * 발행 파이프라인의 parse_meta_description_and_tags 가
 * "설명 | tags: 태그1, 태그2" 형태를 그대로 다시 나눈다.
 * 이 형식을 지켜야 태그가 워드프레스·티스토리에 들어간다.
 */
function 메타합치기(설명, 태그) {
  var s = String(설명 || '').trim();
  var t = String(태그 || '').trim().replace(/^[,\s]+|[,\s]+$/g, '');
  return t ? (s + ' | tags: ' + t) : s;
}

/**
 * 마크다운 응답(글 하나)을 검사한다.
 *
 * 챗지피티·제미나이는 글을 하나만 준다. 워드프레스와 티스토리를 모두
 * 쓰는 카테고리는 어느 쪽 글인지 골라야 하고, 나머지 한쪽은 따로
 * 한 번 더 붙여넣는다.
 */
/**
 * 메타 설명이 없을 때 본문 첫머리로 만든다.
 *
 * 워드프레스도 발췌문이 없으면 본문 앞부분을 쓴다. 같은 방식이다.
 * 마음에 안 들면 시트에서 고치면 된다.
 */
function 메타만들기(본문) {
  var 글 = String(본문 || '')
    .replace(/^\s*#+.*$/gm, '')        // 소제목
    .replace(/^\s*[-*|>].*$/gm, '')    // 목록·표·인용
    .replace(/\[([^\]]*)\]\([^)]*\)/g, '$1')  // 링크는 글자만
    .replace(/[*`_]/g, '')
    .replace(/\s+/g, ' ')
    .trim();
  if (!글) return '';
  if (글.length <= 150) return 글;

  var 자른것 = 글.substring(0, 150);
  var 끝 = -1;
  ['. ', '? ', '! '].forEach(function (표) {
    var 위치 = 자른것.lastIndexOf(표);
    if (위치 > 끝) 끝 = 위치;
  });
  if (끝 >= 60) return 자른것.substring(0, 끝 + 1).trim();
  return 자른것.trim() + '...';
}

/**
 * 태그로 쓸 만한 말인가.
 *
 * 키워드 수집 단계가 '신장 뉴스 해설' 같은 검색용 문구를 롱테일에 넣어
 * 두는데, 그건 태그가 아니다. '신장에' 처럼 조사만 붙은 토막도 뺀다.
 */
function 태그쓸만한가(글자) {
  var t = String(글자 || '').trim();
  if (t.length < 2 || t.length > 25) return false;
  if (/뉴스\s*해설|확인된\s*내용|바로가기|검색어|관련\s*소식/.test(t)) return false;
  // 한 단어인데 조사로 끝나면 토막이다 ('신장에', '물혹이')
  if (t.indexOf(' ') === -1 && t.length >= 3 && /[은는이가을를에의도로와과]$/.test(t)) return false;
  return true;
}

/** 태그가 없을 때 키워드와 롱테일로 만든다. */
function 태그만들기(글하나, 보조) {
  var 후보 = [];
  if (보조 && 보조.키워드) 후보.push(보조.키워드);
  if (글하나 && 글하나.포커스) 후보.push(글하나.포커스);
  if (보조 && 보조.롱테일) {
    String(보조.롱테일).split(/[,\n·|]/).forEach(function (t) { 후보.push(t); });
  }

  var 본것 = {}, 결과 = [];
  후보.forEach(function (t) {
    t = String(t || '').replace(/\s+/g, ' ').trim();
    if (!태그쓸만한가(t)) return;
    var 열쇠 = t.replace(/\s/g, '').toLowerCase();
    if (본것[열쇠]) return;
    본것[열쇠] = true;
    결과.push(t);
  });
  return 결과.slice(0, 8).join(', ');
}

function 글하나검사(글하나, 정보, 채널, 보조) {
  var 문제들 = [];
  if (!글하나.메모) 글하나.메모 = [];

  if (!글하나.제목) 문제들.push('제목을 찾지 못했습니다.');
  if (!글하나.본문 || !글하나.본문.replace(/[#*\-\s]/g, ''))
    문제들.push('본문 내용이 없습니다. 글 전체를 복사했는지 확인해 주세요.');

  // 봇이 포커스 키워드를 안 알려줘서 제목에서 잘라낸 경우라면,
  // 시트에 적힌 메인 키워드가 더 정확하다.
  if (글하나.포커스추정 && 보조 && 보조.키워드) 글하나.포커스 = 보조.키워드;

  // 메타·태그는 봇이 자주 빠뜨린다. 없으면 만들어서 채운다.
  if (!글하나.메타) {
    글하나.메타 = 메타만들기(글하나.본문);
    if (글하나.메타) {
      글하나.메모.push('메타 설명이 없어서 본문 첫머리로 만들었습니다. ' +
                       '시트에서 고치셔도 됩니다.');
    } else {
      문제들.push('메타 설명도 본문도 없어서 만들 수 없습니다.');
    }
  }
  if (!글하나.태그) {
    글하나.태그 = 태그만들기(글하나, 보조);
    if (글하나.태그) {
      글하나.메모.push('태그가 없어서 키워드와 롱테일로 만들었습니다: ' + 글하나.태그);
    } else {
      문제들.push('태그를 찾지 못했고, 키워드와 롱테일도 비어 있어 만들 수 없습니다.');
    }
  }

  var 둘다 = 정보.워드프레스 && 정보.티스토리;
  if (둘다 && 채널 !== 'wordpress' && 채널 !== 'tistory') {
    문제들.push(
      '이 카테고리는 워드프레스와 티스토리 두 곳에 올립니다. ' +
      '이 글이 어느 쪽인지 위에서 골라 주세요.'
    );
  }

  if (문제들.length > 0) return { 문제들: 문제들 };

  var 쓸채널 = 둘다 ? 채널 : (정보.워드프레스 ? 'wordpress' : 'tistory');
  return { 글하나: 글하나, 채널: 쓸채널, HTML: 마크다운을HTML로(글하나.본문) };
}

/**
 * 응답을 나누고 검사한다.
 * 문제가 있으면 { 문제들: [...] }, 없으면 { 항목: {...}, 출처: '...' }.
 */
function 검사하기(글, 카테고리이름, 채널, 보조) {
  var 정보 = 카테고리찾기(카테고리이름);
  var 항목 = 항목나누기(글);
  var 문제들 = [];

  // 대괄호 형식이 아니면 마크다운(챗지피티·제미나이 기본 형식)으로 읽는다
  if (Object.keys(항목).length === 0) {
    var 글하나 = 마크다운나누기(글);
    if (!글하나) {
      return { 문제들: [
        '붙여넣은 내용에서 글 제목을 찾지 못했습니다. ' +
        '제목만 한 줄 알려 주면 나머지는 알아서 맞춥니다. ' +
        '붙여넣은 글 맨 위에 "# 쓰려는 제목" 한 줄을 넣고 다시 저장해 보세요.'
      ] };
    }
    return 글하나검사(글하나, 정보, 채널, 보조);
  }

  var 필요항목 = [];
  if (정보.워드프레스) {
    필요항목 = 필요항목.concat(['WORDPRESS_TITLE', 'WORDPRESS_META_DESCRIPTION',
                                'WORDPRESS_TAGS', 'WORDPRESS_HTML']);
  }
  if (정보.티스토리) {
    필요항목 = 필요항목.concat(['TISTORY_TITLE', 'TISTORY_META_DESCRIPTION',
                                'TISTORY_TAGS', 'TISTORY_HTML']);
  }
  필요항목 = 필요항목.concat(['FOCUS_KEYWORD', 'SOURCES']);

  필요항목.forEach(function (키) {
    var 이름 = 항목이름[키] || 키;
    var 값 = 항목[키];
    if (값 === undefined) {
      문제들.push('[' + 키 + '] (' + 이름 + ') 항목이 없습니다.');
    } else if (!String(값).trim()) {
      문제들.push('[' + 키 + '] (' + 이름 + ') 내용이 비어 있습니다.');
    } else if (키.indexOf('_HTML') !== -1 && 내용없는HTML(값)) {
      문제들.push('[' + 키 + '] (' + 이름 + ') 에 글 내용이 없습니다. HTML 태그만 있습니다.');
    }
  });

  var 출처결과 = 출처나누기(항목.SOURCES);
  문제들 = 문제들.concat(출처결과.문제들);
  if (항목.SOURCES && String(항목.SOURCES).trim() && 출처결과.출처들.length === 0) {
    문제들.push('쓸 수 있는 출처 링크가 하나도 없습니다.');
  }

  // 워드프레스와 티스토리를 똑같이 쓰면 안 된다
  if (정보.워드프레스 && 정보.티스토리 && 문제들.length === 0) {
    [['WORDPRESS_TITLE', 'TISTORY_TITLE', '제목'],
     ['WORDPRESS_META_DESCRIPTION', 'TISTORY_META_DESCRIPTION', '메타 설명'],
     ['WORDPRESS_HTML', 'TISTORY_HTML', '본문']].forEach(function (짝) {
      if (String(항목[짝[0]] || '').trim() === String(항목[짝[1]] || '').trim()) {
        문제들.push('워드프레스와 티스토리의 ' + 짝[2] +
                    '이 똑같습니다. 두 채널은 서로 다르게 써야 합니다.');
      }
    });
  }

  if (문제들.length > 0) return { 문제들: 문제들 };
  return { 항목: 항목, 출처: 출처결과.출처들.join('\n') };
}


// ══════════════════════════════════════════════════════════
//  ④ 저장하기 — 문제가 없을 때만 저장하고 발행대기로 바꾼다
// ══════════════════════════════════════════════════════════

function 저장하기(행번호, 답변, 채널, 키워드) {
  var 준비 = 시트준비();
  var 탭 = 준비.탭, 열 = 준비.열;
  행번호 = 행찾기(탭, 열, 행번호, 키워드);
  var 행 = 탭.getRange(행번호, 1, 1, 탭.getLastColumn()).getValues()[0];
  var 카테고리이름 = String(행[열.category] || '').trim();

  // 메타·태그가 빠졌을 때 대신 쓸 재료 (시트의 키워드와 롱테일)
  function 칸값(키) {
    var 위치 = 열[키];
    return (위치 === -1 || 위치 === undefined) ? '' : String(행[위치] || '').trim();
  }
  var 보조 = {
    키워드: 칸값('keyword'),
    롱테일: (채널 === 'tistory' ? 칸값('ts롱테일') : '') || 칸값('wp롱테일') || 칸값('ts롱테일')
  };

  var 결과 = 검사하기(답변, 카테고리이름, 채널, 보조);
  if (결과.문제들) return { 성공: false, 문제들: 결과.문제들 };

  var 정보 = 카테고리찾기(카테고리이름);

  // 글 하나만 온 경우(챗지피티·제미나이 기본 형식)
  if (결과.글하나) {
    return 글하나저장(탭, 열, 행번호, 결과, 정보);
  }

  var 항목 = 결과.항목;

  var 쓸것 = [['focus', 항목.FOCUS_KEYWORD]];

  if (정보.워드프레스) {
    // 워드프레스가 있는 카테고리 → 기본 칸에는 워드프레스 글
    쓸것 = 쓸것.concat([
      ['title', 항목.WORDPRESS_TITLE],
      ['meta',  메타합치기(항목.WORDPRESS_META_DESCRIPTION, 항목.WORDPRESS_TAGS)],
      ['html',  항목.WORDPRESS_HTML]
    ]);
    if (정보.티스토리) {
      쓸것 = 쓸것.concat([
        ['ts제목', 항목.TISTORY_TITLE],
        ['ts메타', 메타합치기(항목.TISTORY_META_DESCRIPTION, 항목.TISTORY_TAGS)],
        ['ts본문', 항목.TISTORY_HTML]
      ]);
    }
  } else {
    // 티스토리 전용 카테고리(대출관련·꿈해몽) → 티스토리 글을 기본 칸에 쓴다.
    // collect_draft_items 가 'SEO 최적화 제목'과 'HTML 본문 내용'이 비면
    // 그 행을 통째로 건너뛰기 때문이다. 발행 쪽은
    // (item.tistory_title or item.title) 로 기본 칸을 되받아 쓴다.
    쓸것 = 쓸것.concat([
      ['title', 항목.TISTORY_TITLE],
      ['meta',  메타합치기(항목.TISTORY_META_DESCRIPTION, 항목.TISTORY_TAGS)],
      ['html',  항목.TISTORY_HTML]
    ]);
  }

  쓸것.forEach(function (한칸) {
    var 위치 = 열[한칸[0]];
    if (위치 === -1 || 위치 === undefined) return;
    탭.getRange(행번호, 위치 + 1).setValue(한칸[1]);
  });

  // 상태는 맨 마지막에 — 내용이 다 들어간 뒤에만 발행대기가 되도록
  SpreadsheetApp.flush();
  탭.getRange(행번호, 열.status + 1).setValue(완료상태);

  return { 성공: true, 상태: 완료상태 };
}


/**
 * 글 하나(마크다운)를 해당 채널 칸에 저장한다.
 *
 * 워드프레스와 티스토리를 모두 쓰는 카테고리는 한 번에 한쪽만 채워지므로,
 * 양쪽이 다 찼을 때만 상태를 발행대기로 바꾼다. 한쪽만 있는 상태로
 * 발행대기가 되면 발행 도구가 같은 글을 양쪽에 올려 버린다.
 */
function 글하나저장(탭, 열, 행번호, 결과, 정보) {
  var 글 = 결과.글하나;
  var 메타칸 = 메타합치기(글.메타, 글.태그);
  var 둘다 = 정보.워드프레스 && 정보.티스토리;

  function 쓰기(키, 값) {
    var 위치 = 열[키];
    if (위치 === -1 || 위치 === undefined) return;
    탭.getRange(행번호, 위치 + 1).setValue(값);
  }
  function 읽기(키) {
    var 위치 = 열[키];
    if (위치 === -1 || 위치 === undefined) return '';
    return String(탭.getRange(행번호, 위치 + 1).getValue() || '').trim();
  }

  쓰기('focus', 글.포커스);

  if (결과.채널 === 'tistory' && 둘다) {
    // 둘 다 쓰는 카테고리의 티스토리 글 → 티스토리 전용 칸
    쓰기('ts제목', 글.제목);
    쓰기('ts메타', 메타칸);
    쓰기('ts본문', 결과.HTML);
  } else {
    // 워드프레스 글, 또는 한쪽만 쓰는 카테고리 → 기본 칸
    쓰기('title', 글.제목);
    쓰기('meta', 메타칸);
    쓰기('html', 결과.HTML);
  }

  SpreadsheetApp.flush();

  if (둘다) {
    var 워드있음 = !!읽기('title') && !!읽기('html');
    var 티스있음 = !!읽기('ts제목') && !!읽기('ts본문');
    if (!(워드있음 && 티스있음)) {
      var 남은쪽 = 워드있음 ? '티스토리' : '워드프레스';
      return {
        성공: true,
        상태: '',
        더필요: 남은쪽,
        메모: 글.메모 || [],
        안내: 남은쪽 + '용 글이 아직 없습니다. ' +
              남은쪽 + '용으로 한 번 더 받아서 붙여넣어 주세요. ' +
              '두 개가 다 차면 발행대기로 바뀝니다.'
      };
    }
    if (읽기('title') === 읽기('ts제목') || 읽기('html') === 읽기('ts본문')) {
      return {
        성공: false,
        문제들: ['워드프레스와 티스토리 글이 똑같습니다. 두 채널은 서로 다르게 써야 합니다.']
      };
    }
  }

  탭.getRange(행번호, 열.status + 1).setValue(완료상태);
  return { 성공: true, 상태: 완료상태, 메모: 글.메모 || [] };
}


// ══════════════════════════════════════════════════════════
//  ⑤ 발행 확인 — 블로그에 진짜 올라갔는지 직접 보고 판정한다
//
//  비밀번호도 열쇠 파일도 쓰지 않는다. 공개된 것만 본다.
//    · 워드프레스: /wp-json/wp/v2/posts?search=  (공개된 글만 나온다)
//    · 티스토리  : /rss                          (공개된 글만 들어 있다)
//  임시저장·비공개 글은 둘 다 안 나오므로, 나왔다면 공개된 것이다.
// ══════════════════════════════════════════════════════════

/** 제목을 비교하기 좋게 만든다. 띄어쓰기·기호·따옴표 차이를 무시한다. */
/**
 * 자주 나오는 HTML 특수문자 이름표.
 *
 * 여기 없는 이름은 통째로 지운다. 이게 중요하다. 예전에는 &middot; 를
 * 못 풀어서 'middot' 이라는 글자가 제목에 남았다. 제목열쇠는 영문자를
 * 지우지 않으므로 그 다섯 글자가 그대로 열쇠에 섞였고,
 * '중&middot;저신용자' 와 '중·저신용자' 가 다른 글로 보였다.
 */
var 특수문자표 = {
  amp: '&', lt: '<', gt: '>', quot: '"', apos: "'", nbsp: ' ',
  middot: '·', bull: '·', sdot: '·', hellip: '…',
  ndash: '-', mdash: '-', minus: '-', shy: '',
  lsquo: '', rsquo: '', ldquo: '', rdquo: '', sbquo: '', bdquo: '',
  laquo: '', raquo: '', lsaquo: '', rsaquo: '',
  deg: '', times: 'x', divide: '/', plusmn: '', prime: '', Prime: '',
  trade: '', copy: '', reg: '', sect: '', para: '', dagger: '',
  euro: '', pound: '', yen: '', cent: '', curren: '',
  larr: '', rarr: '', uarr: '', darr: '', harr: '',
  ensp: ' ', emsp: ' ', thinsp: ' ', zwj: '', zwnj: '',
  frac12: '', frac14: '', frac34: '', sup1: '1', sup2: '2', sup3: '3'
};

/** HTML 특수문자를 사람이 보는 글자로 되돌린다. */
function 특수문자풀기(글자) {
  return String(글자 || '')
    .replace(/&#[xX]([0-9a-fA-F]+);/g, function (_, n) {
      return String.fromCharCode(parseInt(n, 16));
    })
    .replace(/&#(\d+);/g, function (_, n) { return String.fromCharCode(Number(n)); })
    .replace(/&([a-zA-Z][a-zA-Z0-9]*);/g, function (통째, 이름) {
      // 모르는 이름은 지운다. 남겨 두면 그 글자가 제목의 일부가 되어 버린다.
      return Object.prototype.hasOwnProperty.call(특수문자표, 이름)
        ? 특수문자표[이름] : ' ';
    });
}

function 제목열쇠(글자) {
  return 특수문자풀기(String(글자 || '').replace(/<[^>]+>/g, ''))
    .toLowerCase()
    .replace(/[^0-9a-z가-힣]/g, '');
}

/** 두 제목이 같은 글인가. 워드프레스에서 제목을 조금 고쳤어도 알아본다. */
function 제목같나(가, 나) {
  var a = 제목열쇠(가), b = 제목열쇠(나);
  if (!a || !b) return false;
  if (a === b) return true;
  if (a.indexOf(b) === 0 || b.indexOf(a) === 0) return true;
  var 길이 = Math.min(a.length, b.length, 20);
  return 길이 >= 15 && a.substring(0, 길이) === b.substring(0, 길이);
}

/**
 * 왜 확인이 안 됐는지 도메인별로 적어 둔다.
 * '연결하지 못했습니다' 만 보여 주면 무엇을 고쳐야 할지 알 수 없다.
 */
var 확인실패이유 = {};

/** 사람이 브라우저로 여는 것처럼 보이게 한다. 이걸 안 보내면 막는 곳이 있다. */
var 브라우저인척 = {
  muteHttpExceptions: true,
  followRedirects: true,
  headers: {
    'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) ' +
                  'AppleWebKit/537.36 (KHTML, like Gecko) Chrome/124.0 Safari/537.36',
    'Accept': 'application/rss+xml, application/xml, text/xml, application/json, */*'
  }
};

/** 응답 코드를 사람이 읽을 수 있는 말로. */
function 코드설명(코드) {
  if (코드 === 401 || 코드 === 403) return '응답 ' + 코드 + ' — 접근을 막고 있습니다';
  if (코드 === 404) return '응답 404 — 그 주소에 아무것도 없습니다. 주소가 맞는지 확인해 주세요';
  if (코드 === 0) return '주소를 찾지 못했습니다. 블로그 주소가 맞는지 확인해 주세요';
  if (코드 >= 500) return '응답 ' + 코드 + ' — 블로그 쪽 서버 문제입니다';
  return '응답 ' + 코드;
}

/**
 * 워드프레스에 이 제목의 글이 공개돼 있나.
 * 있으면 주소, 없으면 '', 확인 자체가 안 되면 null.
 */
function 워드프레스에있나(도메인, 제목) {
  var 주소 = 'https://' + 도메인 + '/wp-json/wp/v2/posts'
           + '?per_page=20&_fields=title,link&search=' + encodeURIComponent(제목);
  try {
    var 답 = UrlFetchApp.fetch(주소, 브라우저인척);
    if (답.getResponseCode() !== 200) {
      확인실패이유[도메인] = 코드설명(답.getResponseCode());
      return null;
    }
    var 글들 = JSON.parse(답.getContentText());
    if (!글들 || !글들.length) return '';
    for (var i = 0; i < 글들.length; i++) {
      var 그제목 = (글들[i].title && 글들[i].title.rendered) || '';
      if (제목같나(그제목, 제목)) return 글들[i].link || '';
    }
    return '';
  } catch (e) {
    확인실패이유[도메인] = 코드설명(0);
    return null;
  }
}

/** 티스토리 RSS 를 한 번만 받아 둔다 (같은 블로그를 여러 번 안 부르려고). */
var RSS보관 = {};

/**
 * 티스토리에 이 제목의 글이 공개돼 있나.
 * 있으면 주소, 없으면 '', 확인 자체가 안 되면 null.
 */
function 티스토리에있나(도메인, 제목) {
  if (!(도메인 in RSS보관)) {
    RSS보관[도메인] = null;
    var 길들 = ['/rss', '/rss.xml', '/feed'];   // 블로그마다 주소가 조금 다르다
    var 마지막코드 = 0;
    for (var g = 0; g < 길들.length; g++) {
      try {
        var 답 = UrlFetchApp.fetch('https://' + 도메인 + 길들[g], 브라우저인척);
        마지막코드 = 답.getResponseCode();
        if (마지막코드 === 200) {
          var 원문g = 답.getContentText();
          if (원문g.indexOf('<item') !== -1) { RSS보관[도메인] = 원문g; break; }
          마지막코드 = 200;   // 200 인데 글 목록이 아님
        }
      } catch (e) {
        마지막코드 = 0;
      }
    }
    if (RSS보관[도메인] === null) {
      확인실패이유[도메인] = (마지막코드 === 200)
        ? '글 목록(RSS)을 받았는데 글이 하나도 없습니다'
        : 코드설명(마지막코드);
    }
  }
  var 원문 = RSS보관[도메인];
  if (원문 === null || 원문 === undefined) return null;

  var 항목들 = 원문.match(/<item[\s\S]*?<\/item>/g) || [];
  for (var i = 0; i < 항목들.length; i++) {
    var 제목m = /<title>([\s\S]*?)<\/title>/.exec(항목들[i]);
    var 링크m = /<link>([\s\S]*?)<\/link>/.exec(항목들[i]);
    if (!제목m) continue;
    var 그제목 = 제목m[1].replace(/<!\[CDATA\[|\]\]>/g, '').trim();
    if (제목같나(그제목, 제목)) {
      return 링크m ? 링크m[1].replace(/<!\[CDATA\[|\]\]>/g, '').trim() : '';
    }
  }
  return '';
}

/** '발행완료' 탭을 가져온다. 없으면 만든다. */
function 완료탭가져오기() {
  var 문서 = 문서가져오기();
  var 탭 = 문서.getSheetByName(완료탭이름);
  if (탭) return { 탭: 탭, 새로만듦: false };
  return { 탭: 문서.insertSheet(완료탭이름), 새로만듦: true };
}

/**
 * 한 행을 발행완료 탭으로 옮겨 담는다.
 *
 * 열 순서가 달라도 되도록 헤더 이름으로 짝을 지어 넣는다.
 * 발행완료 탭이 비어 있으면 오늘작성의 헤더를 그대로 만들어 준다.
 */
function 완료탭에넣기(완료탭, 원본헤더, 원본값) {
  var 마지막열 = 완료탭.getLastColumn();
  var 완료헤더 = (완료탭.getLastRow() >= 1 && 마지막열 >= 1)
    ? 완료탭.getRange(1, 1, 1, 마지막열).getValues()[0] : [];

  if (완료헤더.join('').trim() === '') {
    완료탭.getRange(1, 1, 1, 원본헤더.length).setValues([원본헤더]);
    완료헤더 = 원본헤더.slice();
  }

  var 다듬은원본 = 원본헤더.map(다듬기);
  var 줄 = 완료헤더.map(function (이름) {
    var 위치 = 다듬은원본.indexOf(다듬기(이름));
    return 위치 === -1 ? '' : 원본값[위치];
  });
  완료탭.getRange(완료탭.getLastRow() + 1, 1, 1, 줄.length).setValues([줄]);
}

/**
 * 오늘작성의 각 행을 블로그에서 직접 확인한다.
 *
 * 그 카테고리가 쓰는 곳에 **전부** 올라가 있을 때만 발행완료로 보고,
 * 상태를 바꾼 뒤 발행완료 탭으로 옮긴다. 한 곳이라도 안 보이면 그냥 둔다.
 */
function 발행확인() {
  RSS보관 = {};
  확인실패이유 = {};
  var 준비 = 시트준비();
  var 탭 = 준비.탭, 열 = 준비.열, 헤더 = 준비.헤더;
  var 마지막행 = 탭.getLastRow();
  if (마지막행 < 2) return { 결과: [], 옮긴수: 0 };

  var 값 = 탭.getRange(2, 1, 마지막행 - 1, 탭.getLastColumn()).getValues();
  var 결과 = [], 옮길행 = [];

  값.forEach(function (행, i) {
    var 행번호 = i + 2;
    var 키워드 = String(행[열.keyword] || '').trim();
    if (!키워드) return;

    var 상태 = String(행[열.status] || '').trim();
    if (상태 === 발행완료상태) return;

    var 카테고리이름 = String(행[열.category] || '').trim();
    var 정보 = 카테고리표[카테고리이름];
    if (!정보) {
      결과.push({ 행번호: 행번호, 키워드: 키워드, 판정: '건너뜀',
                  설명: '모르는 카테고리: ' + (카테고리이름 || '(비어 있음)') });
      return;
    }

    var wp제목 = String((열.title !== -1 ? 행[열.title] : '') || '').trim();
    var ts제목 = String((열['ts제목'] !== -1 ? 행[열['ts제목']] : '') || '').trim();
    // 티스토리만 쓰는 카테고리는 티스토리 글이 기본 칸에 들어 있다
    if (!정보.워드프레스 && !ts제목) ts제목 = wp제목;

    if (!wp제목 && !ts제목) {
      결과.push({ 행번호: 행번호, 키워드: 키워드, 판정: '건너뜀',
                  설명: '아직 글이 없습니다' });
      return;
    }

    var 확인못함 = [], 아직 = [], wp주소 = '', ts주소 = '';

    if (정보.워드프레스) {
      var w = wp제목 ? 워드프레스에있나(정보.워드프레스, wp제목) : '';
      if (w === null) 확인못함.push(정보.워드프레스);
      else if (!w) 아직.push('워드프레스');
      else wp주소 = w;
    }
    if (정보.티스토리) {
      var t = ts제목 ? 티스토리에있나(정보.티스토리, ts제목) : '';
      if (t === null) 확인못함.push(정보.티스토리);
      else if (!t) 아직.push('티스토리');
      else ts주소 = t;
    }

    // 찾은 주소는 아직 다 안 올라갔어도 적어 둔다
    if (wp주소 && 열['wp주소'] !== -1) 탭.getRange(행번호, 열['wp주소'] + 1).setValue(wp주소);
    if (ts주소 && 열['ts주소'] !== -1) 탭.getRange(행번호, 열['ts주소'] + 1).setValue(ts주소);

    if (확인못함.length) {
      결과.push({
        행번호: 행번호, 키워드: 키워드, 판정: '확인 실패',
        설명: 확인못함.map(function (d) {
          return d + ' — ' + (확인실패이유[d] || '연결하지 못했습니다');
        }).join(' / ')
      });
      return;
    }
    if (아직.length) {
      결과.push({ 행번호: 행번호, 키워드: 키워드, 판정: '아직',
                  설명: 아직.join('·') + ' 에서 아직 안 보입니다' });
      return;
    }

    탭.getRange(행번호, 열.status + 1).setValue(발행완료상태);
    옮길행.push(행번호);
    결과.push({ 행번호: 행번호, 키워드: 키워드, 판정: '발행완료',
                설명: '두 곳 다 확인했습니다' });
  });

  var 옮긴수 = 0, 새탭만듦 = false;
  if (옮길행.length) {
    SpreadsheetApp.flush();
    var 완료 = 완료탭가져오기();
    새탭만듦 = 완료.새로만듦;

    옮길행.forEach(function (행번호) {
      var 값한줄 = 탭.getRange(행번호, 1, 1, 탭.getLastColumn()).getValues()[0];
      완료탭에넣기(완료.탭, 헤더, 값한줄);
    });
    SpreadsheetApp.flush();

    // 행을 지우면 아래 번호가 당겨지므로 뒤에서부터 지운다
    옮길행.slice().sort(function (가, 나) { return 나 - 가; })
      .forEach(function (행번호) { 탭.deleteRow(행번호); });
    옮긴수 = 옮길행.length;
  }

  // finwiz 로드맵을 쓰는 경우, 방금 찾아낸 글 주소를 링크관리에 적어 둔다.
  // 이게 돌아야 다음 글이 이 글을 내부 링크로 걸 수 있다.
  var finwiz반영 = 0;
  if (typeof finwiz주소반영 === 'function') {
    try { finwiz반영 = (finwiz주소반영() || {}).반영 || 0; } catch (오류) { finwiz반영 = 0; }
  }

  return { 결과: 결과, 옮긴수: 옮긴수, 새탭만듦: 새탭만듦, 완료탭: 완료탭이름,
           finwiz반영: finwiz반영 };
}
