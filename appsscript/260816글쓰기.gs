/**
 * 이 도구가 쓸 스프레드시트.
 *
 * 시트 메뉴에서 열면 getActive() 가 그 시트를 준다. 웹앱 주소로 열면
 * '지금 열려 있는 시트' 가 없으므로 시트ID 로 직접 연다.
 */
function 문서가져오기() {
  var 문서 = null;
  try { 문서 = SpreadsheetApp.getActive(); } catch (e) { 문서 = null; }
  if (문서) return 문서;

  if (시트ID) {
    try { return SpreadsheetApp.openById(시트ID); } catch (e) {
      throw new Error(
        '시트를 열지 못했습니다.\n' +
        '코드 맨 위의 시트ID 가 맞는지 확인해 주세요.\n' + e.message
      );
    }
  }
  throw new Error('시트를 찾지 못했습니다. 코드 맨 위에 시트ID 를 넣어 주세요.');
}


