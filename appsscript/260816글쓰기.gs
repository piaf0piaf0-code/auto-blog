/**
 * 메뉴에서 부르는 발행 확인.
 *
 * 사이드바 버튼과 하는 일은 같다. 결과를 화면 대신 알림창에 보여 준다.
 */
function 발행확인메뉴() {
  var ui = SpreadsheetApp.getUi();
  var 결과 = 발행확인();
  var 목록 = 결과.결과 || [];

  var 글 = '';
  if (결과.옮긴수 > 0) {
    글 += '✅ ' + 결과.옮긴수 + '개를 ' + 결과.완료탭 + ' 탭으로 옮겼습니다.\n';
    if (결과.새탭만듦) 글 += '(' + 결과.완료탭 + ' 탭이 없어서 새로 만들었습니다.)\n';
    글 += '\n';
  }

  if (!목록.length) {
    글 += '확인할 글감이 없습니다.';
  } else {
    var 줄들 = 목록.map(function (r) {
      return '[' + r.판정 + '] ' + r.키워드 + '\n    ' + r.설명;
    });
    // 알림창은 길면 잘린다. 넘치면 앞쪽만 보여 주고 나머지는 개수로 알린다.
    var 최대 = 25;
    글 += 줄들.slice(0, 최대).join('\n');
    if (줄들.length > 최대) {
      글 += '\n\n... 그 밖에 ' + (줄들.length - 최대) + '개 더 있습니다. ' +
            '전부 보시려면 사이드바의 🔎 발행됐는지 확인 을 쓰세요.';
    }
  }

  ui.alert('발행 확인', 글, ui.ButtonSet.OK);
}

